# RemitLine environment template
# Copy this file to .env.local, then replace the blank/example values.
# Never commit .env.local or paste secret values into chat.

# ElevenLabs server API key. Keep this server-side only.
ELEVENLABS_API_KEY=

# ElevenLabs voice used by the provisioning script.
ELEVENLABS_VOICE_ID=R4tcGTPPxmfcPmqAg2Li

# Public identifier for the configured ElevenLabs agent.
NEXT_PUBLIC_AGENT_ID=

# Base URL used when configuring the ElevenLabs GET webhook tools.
TOOL_BASE_URL=http://localhost:3000

# Protects /admin and the /api/admin/* routes.
ADMIN_ACCESS_CODE=

# Optional phone escalation destination for agent provisioning.
# Must be E.164 format. This is used only when provisioning a phone-enabled agent.
SPECIALIST_PHONE=
# Example: +971501234567

# Optional durable Vercel storage. Get both values from Upstash:
# Database → Connect → REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
